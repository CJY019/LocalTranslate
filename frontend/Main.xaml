<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource app.name}" Width="960" Height="650" MinWidth="750" MinHeight="515" WindowStartupLocation="CenterScreen" Background="#FBFCFB" FontFamily="Segoe UI, Microsoft YaHei UI" Language="{DynamicResource ui.xmlLanguage}" FontSize="14" Foreground="{StaticResource Ink}" UseLayoutRounding="True" AllowDrop="True">
  <Grid Margin="28,20,28,14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel LastChildFill="False">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
        <Image x:Name="BrandIcon" Width="36" Height="36" Stretch="Uniform" VerticalAlignment="Center"/>
        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="25" FontWeight="SemiBold" Text="{DynamicResource app.name}"/>
      </StackPanel>
      <ToggleButton x:Name="CaptureSwitch" DockPanel.Dock="Right" Style="{StaticResource CaptureSwitch}" AutomationProperties.Name="{DynamicResource selection.title}" ToolTip="{DynamicResource selection.tip}"/>
    </DockPanel>
    <Border x:Name="OptionsBar" Grid.Row="1" Margin="0,20,0,14" Padding="0,0,0,15" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Line}">
      <Grid><StackPanel x:Name="TranslationOptions" Orientation="Horizontal">
        <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource common.model}" Margin="0,0,9,0"/>
        <ComboBox x:Name="Models" DisplayMemberPath="Display" Width="150" AutomationProperties.Name="{DynamicResource common.translation_model}"/>
        <TextBlock Margin="16,0,7,0" Style="{StaticResource Caption}" Text="{DynamicResource common.source_language}"/>
        <ComboBox x:Name="SourceLanguage" DisplayMemberPath="Name" Width="128" MaxDropDownHeight="360" AutomationProperties.Name="{DynamicResource common.source_language}"/>
        <TextBlock Margin="14,0,7,0" Style="{StaticResource Caption}" Text="{DynamicResource common.target_language}"/>
        <ComboBox x:Name="TargetLanguage" DisplayMemberPath="Name" Width="128" MaxDropDownHeight="360" AutomationProperties.Name="{DynamicResource common.target_language}"/>
        <Button x:Name="ShowLanguages" Margin="10,0,0,0" Padding="8,2" FontSize="12" Content="{DynamicResource common.language_button}" AutomationProperties.Name="{DynamicResource common.language_button_tip}"/>
        <Popup x:Name="LanguagePopup" PlacementTarget="{Binding ElementName=ShowLanguages}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
          <Border Margin="0,4,0,0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="{StaticResource ControlCorner}" Padding="14" Width="345">
            <StackPanel><TextBlock x:Name="LanguageTitle" FontWeight="SemiBold" Margin="0,0,0,7"/>
              <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="LanguageList" TextWrapping="Wrap" FontSize="13" LineHeight="22"/></ScrollViewer>
            </StackPanel>
          </Border>
        </Popup>
      </StackPanel>
        <StackPanel x:Name="ChatOptions" Visibility="Collapsed" Orientation="Horizontal">
          <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource chat.model}" Margin="0,0,9,0"/>
          <ComboBox x:Name="ChatModel" Width="190" DisplayMemberPath="Name" AutomationProperties.Name="{DynamicResource chat.model}"/>
        </StackPanel>
      </Grid>
    </Border>
    <TabControl x:Name="Workspace" Grid.Row="2" BorderThickness="0" Background="Transparent" Padding="0">
      <TabItem Header="{DynamicResource tab.text}">
        <Grid Margin="0,13,0,0" TextElement.FontWeight="Normal"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="{StaticResource ControlCorner}" Background="White">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Caption}" FontWeight="SemiBold" Text="{DynamicResource common.source}"/>
                <Grid Grid.Row="1" Margin="0,9,0,0">
                  <TextBlock x:Name="SourceHint" IsHitTestVisible="False" Foreground="#85958F" FontSize="15" Text="{DynamicResource text.placeholder}" Margin="2,4,0,0"/>
                  <TextBox x:Name="Source" Style="{StaticResource Editor}" AutomationProperties.Name="{DynamicResource common.source}"/>
                </Grid>
              </Grid>
              <Border Grid.Column="1" Background="{StaticResource Line}"/>
              <Grid Grid.Column="2" Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Caption}" FontWeight="SemiBold" Text="{DynamicResource common.result}"/>
                <TextBox Grid.Row="1" Margin="0,9,0,0" x:Name="Result" Style="{StaticResource Editor}" IsReadOnly="True" AutomationProperties.Name="{DynamicResource common.result}"/>
              </Grid>
            </Grid>
          </Border>
          <DockPanel Grid.Row="1" Margin="0,14,0,4" LastChildFill="True">
            <Button x:Name="Translate" DockPanel.Dock="Right" Style="{StaticResource Primary}" MinWidth="98" Content="{DynamicResource common.translate}"/>
            <Button x:Name="Stop" DockPanel.Dock="Right" Margin="0,0,8,0" Content="{DynamicResource common.stop}" Visibility="Collapsed"/>
            <Button x:Name="Copy" DockPanel.Dock="Right" Margin="0,0,8,0" Content="{DynamicResource common.copy_result}" IsEnabled="False"/>
            <TextBlock x:Name="TextStatus" Style="{StaticResource Caption}" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
        </Grid>
      </TabItem>
      <TabItem x:Name="FileTab" Header="{DynamicResource tab.files}">
        <Grid Margin="0,12,0,0" TextElement.FontWeight="Normal"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel LastChildFill="False">
            <Button x:Name="AddFiles" Content="{DynamicResource file.add}" Margin="0,0,8,0"/>
            <Button x:Name="AddFolder" Content="{DynamicResource file.add_folder}" Margin="0,0,8,0"/>
            <Button x:Name="RenameFile" Content="{DynamicResource file.rename}" Margin="0,0,8,0" ToolTip="{DynamicResource file.rename_tip}"/>
            <Button x:Name="ClearFiles" Content="{DynamicResource file.clear}"/>
            <ComboBox x:Name="FileMode" DockPanel.Dock="Right" MinWidth="118" SelectedIndex="0" AutomationProperties.Name="{DynamicResource file.format}"><ComboBoxItem Content="{DynamicResource file.only}"/><ComboBoxItem Content="{DynamicResource file.both}"/></ComboBox>
          </DockPanel>
          <DockPanel Grid.Row="1" Margin="0,8,0,9">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Caption}" Text="{DynamicResource file.save_to}" Margin="0,0,9,0"/>
            <Button DockPanel.Dock="Right" x:Name="ResetOutputDir" Content="{DynamicResource file.reset_dir}" FontSize="12" Padding="8,2" MinHeight="26" Margin="6,0,0,0"/>
            <Button DockPanel.Dock="Right" x:Name="ChooseOutputDir" Content="{DynamicResource file.choose_dir}" FontSize="12" Padding="8,2" MinHeight="26" Margin="8,0,0,0" ToolTip="{DynamicResource file.choose_dir_tip}"/>
            <TextBlock x:Name="OutputDirectory" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13"/>
          </DockPanel>
          <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="{StaticResource ControlCorner}">
            <Grid><ListView x:Name="Files" BorderThickness="0" Margin="2" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource file.queue}" SelectionMode="Extended">
                <ListView.View><GridView>
                  <GridViewColumn Header="{DynamicResource file.source}" Width="165"><GridViewColumn.CellTemplate><DataTemplate>
                    <TextBlock Text="{Binding Name}" ToolTip="{Binding SourcePath}" TextTrimming="CharacterEllipsis"/>
                  </DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                  <GridViewColumn Header="{DynamicResource file.output}" Width="151"><GridViewColumn.CellTemplate><DataTemplate>
                    <TextBlock Text="{Binding OutputName}" ToolTip="{Binding NameHint}" TextTrimming="CharacterEllipsis"/>
                  </DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                  <GridViewColumn Header="{DynamicResource file.status}" Width="105" DisplayMemberBinding="{Binding State}"/>
                  <GridViewColumn Header="{DynamicResource file.details}" Width="320"><GridViewColumn.CellTemplate><DataTemplate>
                    <TextBlock Text="{Binding Detail}" ToolTip="{Binding Detail}" TextTrimming="CharacterEllipsis"/>
                  </DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                </GridView></ListView.View>
              </ListView>
              <StackPanel x:Name="DropHint" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0">
                <TextBlock Text="{DynamicResource file.drop}" HorizontalAlignment="Center" Foreground="{StaticResource Muted}"/>
                <TextBlock Text="TXT · MD · DOCX · PDF · SRT · VTT" HorizontalAlignment="Center" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
              </StackPanel>
            </Grid>
          </Border>
          <ProgressBar Grid.Row="3" x:Name="JobProgress" Height="4" Minimum="0" Maximum="100" Margin="0,10,0,0" Foreground="{StaticResource Teal}" Background="#E4EBE8"/>
          <DockPanel Grid.Row="4" Margin="0,10,0,4" LastChildFill="True">
            <Button DockPanel.Dock="Right" x:Name="RunJob" Style="{StaticResource Primary}" Content="{DynamicResource common.translate}"/>
            <Button DockPanel.Dock="Right" x:Name="CancelJob" Margin="0,0,8,0" Content="{DynamicResource file.cancel_job}" Visibility="Collapsed"/>
            <Button DockPanel.Dock="Right" x:Name="RetryJob" Margin="0,0,8,0" Content="{DynamicResource file.retry}" Visibility="Collapsed"/>
            <TextBlock x:Name="JobStatus" Margin="0,0,8,0" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
        </Grid>
      </TabItem>
      <TabItem x:Name="ImageTab" Header="{DynamicResource tab.images}">
        <Grid Margin="0,12,0,0" TextElement.FontWeight="Normal">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,10">
            <Button x:Name="ChooseImage" Content="{DynamicResource image.choose}" Margin="0,0,8,0"/>
            <Button x:Name="PasteImage" Content="{DynamicResource image.paste}" ToolTip="{DynamicResource image.paste_tip}" Margin="0,0,12,0"/>
            <TextBlock x:Name="ImageName" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="White" CornerRadius="{StaticResource ControlCorner}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource image.original}" FontWeight="SemiBold"/>
                <Grid Grid.Row="1" Margin="0,10,0,0">
                  <Image x:Name="ImagePreview" Stretch="Uniform" StretchDirection="DownOnly" AutomationProperties.Name="{DynamicResource image.preview}"/>
                  <StackPanel x:Name="ImageHint" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{DynamicResource image.drop}" HorizontalAlignment="Center" Foreground="{StaticResource Muted}"/>
                    <TextBlock x:Name="ImageFormats" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                  </StackPanel>
                </Grid>
              </Grid>
              <Border Grid.Column="1" Background="{StaticResource Line}"/>
              <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="1"/><RowDefinition/></Grid.RowDefinitions>
                <Grid Margin="16,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                  <DockPanel>
                    <TextBlock x:Name="ImageEngine" DockPanel.Dock="Right" Style="{StaticResource Caption}" Margin="8,0,0,0"/>
                    <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource image.editable}" FontWeight="SemiBold"/>
                  </DockPanel>
                  <TextBox x:Name="ImageSource" Grid.Row="1" Margin="0,5,0,0" Style="{StaticResource Editor}" AutomationProperties.Name="{DynamicResource image.source}"/>
                </Grid>
                <Border Grid.Row="1" Background="{StaticResource Line}"/>
                <Grid Grid.Row="2" Margin="16,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                  <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource common.result}" FontWeight="SemiBold"/>
                  <TextBox Grid.Row="1" x:Name="ImageResult" Margin="0,5,0,0" IsReadOnly="True" Style="{StaticResource Editor}" AutomationProperties.Name="{DynamicResource image.result}"/>
                </Grid>
              </Grid>
            </Grid>
          </Border>
          <Grid Grid.Row="2" Margin="0,10,0,4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="OcrInfo" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <DockPanel Grid.Row="1">
              <Button x:Name="ImageTranslate" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="{DynamicResource image.recognize_translate}" Margin="8,0,0,0" IsEnabled="False"/>
              <Button x:Name="ImageStop" DockPanel.Dock="Right" Content="{DynamicResource common.stop}" Visibility="Collapsed" Margin="8,0,0,0"/>
              <Button x:Name="ImageCopy" DockPanel.Dock="Right" Content="{DynamicResource common.copy_result}" IsEnabled="False"/>
              <Button x:Name="ImageRecognize" DockPanel.Dock="Right" Content="{DynamicResource image.recognize}" Margin="0,0,8,0" IsEnabled="False" ToolTip="{DynamicResource image.recognize_tip}"/>
              <TextBlock x:Name="ImageStatus" Style="{StaticResource Caption}" Margin="0,0,8,0" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem x:Name="ChatTab" Header="{DynamicResource tab.chat}">
        <Grid Margin="0,12,0,0" TextElement.FontWeight="Normal">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border CornerRadius="{StaticResource ControlCorner}" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <ScrollViewer x:Name="ChatScroll" Padding="14,12" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
              <StackPanel>
                <Border x:Name="ChatWelcome" HorizontalAlignment="Left" Margin="0,0,40,8" Background="#F0F4F2" CornerRadius="{StaticResource ControlCorner}" Padding="12,9">
                  <StackPanel><TextBlock Text="{DynamicResource chat.assistant}" FontWeight="SemiBold" Foreground="{StaticResource Teal}" FontSize="12"/>
                    <TextBlock Text="{DynamicResource chat.welcome}" Foreground="{StaticResource Ink}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <ItemsControl x:Name="ChatMessages" AutomationProperties.Name="{DynamicResource chat.history}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border x:Name="Bubble" HorizontalAlignment="Left" Margin="0,0,50,8" Padding="12,8" Background="#F0F4F2" CornerRadius="{StaticResource ControlCorner}">
                        <StackPanel>
                          <TextBlock Text="{Binding Author}" FontSize="12" Foreground="{StaticResource Teal}" FontWeight="SemiBold"/>
                          <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                   Padding="0" Margin="0,3,0,0" FontSize="14" Foreground="{StaticResource Ink}" AutomationProperties.Name="{Binding Author}"/>
                          <DockPanel x:Name="MessageActions" Margin="0,5,0,0" LastChildFill="False">
                            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                            <Button x:Name="CopyReply" DockPanel.Dock="Right" Content="{DynamicResource common.copy}" AutomationProperties.Name="{DynamicResource chat.copy}" MinHeight="20" Padding="5,0" Margin="8,0,0,0" FontSize="12"
                                    Visibility="Hidden"/>
                          </DockPanel>
                        </StackPanel>
                      </Border>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding CanCopy}" Value="True"><Setter TargetName="CopyReply" Property="Visibility" Value="Visible"/></DataTrigger>
                        <DataTrigger Binding="{Binding IsUser}" Value="True">
                          <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Bubble" Property="Margin" Value="50,0,0,8"/>
                          <Setter TargetName="Bubble" Property="Background" Value="#E6F3EF"/><Setter TargetName="MessageActions" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Border>
          <Border Grid.Row="1" Margin="0,10,0,0" Padding="9,4" BorderThickness="1" Background="White" CornerRadius="{StaticResource ControlCorner}">
            <Border.Style><Style TargetType="Border">
              <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
              <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Teal}"/></Trigger></Style.Triggers>
            </Style></Border.Style>
            <DockPanel>
              <Button DockPanel.Dock="Right" x:Name="ChatSend" Content="{DynamicResource chat.send}" Style="{StaticResource Primary}" VerticalAlignment="Bottom" Margin="8,0,0,0"/>
              <Button DockPanel.Dock="Right" x:Name="ChatStop" Content="{DynamicResource common.stop}" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="8,0,0,0"/>
              <Grid>
                <TextBlock x:Name="ChatHint" Text="{DynamicResource chat.placeholder}" Foreground="#85958F" IsHitTestVisible="False" Margin="2,4,0,0"/>
                <TextBox x:Name="ChatInput" AutomationProperties.Name="{DynamicResource chat.message}" Style="{StaticResource Editor}" MinLines="1" MaxLines="4" FontSize="14" ToolTip="{DynamicResource chat.keyboard}"/>
              </Grid>
            </DockPanel>
          </Border>
          <DockPanel Grid.Row="2" Margin="0,7,0,0">
            <Button DockPanel.Dock="Right" x:Name="ChatClear" Content="{DynamicResource chat.clear}" Padding="9,2" MinHeight="26"/>
            <Button DockPanel.Dock="Right" x:Name="ChatRetry" Content="{DynamicResource chat.retry}" Padding="9,2" MinHeight="26" Margin="0,0,7,0" Visibility="Collapsed"/>
            <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource chat.keyboard_short}"/>
          </DockPanel>
        </Grid>
      </TabItem>
      <TabItem x:Name="SettingsTab" Header="{DynamicResource tab.settings}">
        <ScrollViewer Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <StackPanel TextElement.FontWeight="Normal" Margin="2,0,12,10">
            <TextBlock Text="{DynamicResource settings.language}" FontSize="17" FontWeight="SemiBold"/>
            <ComboBox x:Name="UiLanguage" Width="260" HorizontalAlignment="Left" Margin="0,9,0,0"
                      DisplayMemberPath="Display" AutomationProperties.Name="{DynamicResource settings.language}"/>
            <TextBlock Text="{DynamicResource settings.language_help}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,7,0,0"/>
            <TextBlock x:Name="UiLanguageStatus" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"/>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,16,0,15"/>
            <ContentControl x:Name="ModelManagerHost" HorizontalContentAlignment="Stretch"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <DockPanel x:Name="TranslationFooter" Grid.Row="3" Margin="0,14,0,0" LastChildFill="True">
      <Ellipse x:Name="HealthDot" DockPanel.Dock="Left" Width="7" Height="7" Fill="#889792" VerticalAlignment="Center" Margin="0,0,7,0"/>
      <TextBlock x:Name="Health" Text="{DynamicResource status.connecting}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
    <DockPanel x:Name="ChatFooter" Grid.Row="3" Margin="0,14,0,0" LastChildFill="True" Visibility="Collapsed">
      <Button x:Name="ChatReconnect" DockPanel.Dock="Right" Content="{DynamicResource status.reconnect}" MinHeight="22" Padding="8,0" Visibility="Collapsed"/>
      <TextBlock x:Name="ChatStatus" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
  </Grid>
</Window>
