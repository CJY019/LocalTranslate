<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource selection.title}" Width="410" Height="385" MinWidth="330" MinHeight="305"
        WindowStyle="None" ResizeMode="CanResize" Topmost="True" ShowInTaskbar="False"
        UseLayoutRounding="True" Background="White" Foreground="{StaticResource Ink}"
        FontFamily="Segoe UI, Microsoft YaHei UI" Language="{DynamicResource ui.xmlLanguage}" FontSize="13">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="35" ResizeBorderThickness="6" GlassFrameThickness="0"
                  CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <DataTemplate x:Key="LanguageItem">
      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
    </DataTemplate>
  </Window.Resources>
  <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
        <Grid Margin="14,0,6,0">
          <TextBlock Text="{DynamicResource selection.title}" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <Button x:Name="ClosePopup" Width="30" Height="30" MinHeight="0" Padding="0"
                  HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="{DynamicResource common.close}"
                  AutomationProperties.Name="{DynamicResource selection.close}" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="CloseFrame" Background="Transparent" BorderBrush="Transparent"
                        BorderThickness="1" CornerRadius="{StaticResource ControlCorner}">
                  <Grid Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M 1.5,1.5 L 10.5,10.5 M 10.5,1.5 L 1.5,10.5" Stretch="None"
                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  </Grid>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="CloseFrame" Property="Background" Value="#EDF3F1"/>
                  </Trigger>
                  <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="CloseFrame" Property="BorderBrush" Value="{StaticResource Teal}"/>
                  </Trigger>
                  <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="CloseFrame" Property="Background" Value="#DBE7E3"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="14,10,14,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
          <Button x:Name="Again" DockPanel.Dock="Right" Margin="8,0,0,0" Content="{DynamicResource selection.again}" Style="{StaticResource Primary}"/>
          <ComboBox x:Name="Models" DisplayMemberPath="Display" AutomationProperties.Name="{DynamicResource selection.model}"/>
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,8,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{DynamicResource common.source_language}" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
            <ComboBox x:Name="SourceLanguage" ItemTemplate="{StaticResource LanguageItem}"
                      MaxDropDownHeight="320" ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}"
                      AutomationProperties.Name="{DynamicResource common.source_language}"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="{DynamicResource common.target_language}" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
            <ComboBox x:Name="TargetLanguage" ItemTemplate="{StaticResource LanguageItem}"
                      MaxDropDownHeight="320" ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}"
                      AutomationProperties.Name="{DynamicResource common.target_language}"/>
          </StackPanel>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,0,0,4">
          <Border Padding="8,5" Background="#F1F5F3" CornerRadius="{StaticResource ControlCorner}">
            <TextBlock x:Name="Original" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" FontSize="12"/>
          </Border>
          <TextBlock x:Name="ResultLanguages" Margin="0,3,0,0" Style="{StaticResource Caption}"
                     TextTrimming="CharacterEllipsis" Visibility="Collapsed" AutomationProperties.Name="{DynamicResource selection.detected_label}"/>
        </StackPanel>
        <TextBox Grid.Row="3" x:Name="Result" IsReadOnly="True" AutomationProperties.Name="{DynamicResource selection.result}" Style="{StaticResource Editor}"/>
        <DockPanel Grid.Row="4" Margin="0,6,0,0">
          <Button x:Name="Copy" DockPanel.Dock="Right" IsEnabled="False" Content="{DynamicResource common.copy}"/>
          <Button x:Name="Stop" DockPanel.Dock="Right" Margin="0,0,6,0" Content="{DynamicResource common.stop}"/>
          <TextBlock x:Name="Status" Margin="0,0,5,0" TextTrimming="CharacterEllipsis" Style="{StaticResource Caption}"/>
        </DockPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
